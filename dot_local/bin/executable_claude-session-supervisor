#!/bin/bash
# claude-session-supervisor
#
# Keeps one `claude remote-control` process alive per directory listed in
# ~/.config/claude-sessions/directories. Managed by launchd — KeepAlive
# ensures this supervisor itself is restarted if it ever exits.
#
# Log files: ~/.local/share/claude-sessions/logs/<dirname>.log
#
# Compatible with bash 3.2 (default macOS /bin/bash).

set -uo pipefail

CONFIG_FILE="${HOME}/.config/claude-sessions/directories"
LOG_DIR="${HOME}/.local/share/claude-sessions/logs"

mkdir -p "$LOG_DIR"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

find_claude() {
  local path
  for path in \
    "$(command -v claude 2>/dev/null || true)" \
    "${HOME}/.local/bin/claude" \
    "${HOME}/.claude/bin/claude" \
    "/opt/homebrew/bin/claude" \
    "/usr/local/bin/claude"; do
    [[ -n "$path" && -x "$path" ]] && { echo "$path"; return 0; }
  done
  log "[supervisor] ERROR: claude binary not found in PATH or known locations"
  return 1
}

read_dirs() {
  [[ -f "$CONFIG_FILE" ]] || { log "[supervisor] ERROR: Config not found: $CONFIG_FILE"; exit 1; }
  grep -v '^\s*#' "$CONFIG_FILE" | grep -v '^\s*$' | sed "s|^~|${HOME}|"
}

# One restart loop per directory, runs as a background subshell.
# Backoff: 5s -> 10s -> 20s -> 40s -> 60s (cap). Resets if process ran >60s.
watch_dir() {
  local dir="$1"
  local claude="$2"
  local name logfile count_file backoff started now elapsed count session_name
  name=$(basename "$dir")
  logfile="${LOG_DIR}/${name}.log"
  count_file="${LOG_DIR}/${name}.count"
  backoff=5

  while true; do
    if [[ ! -d "$dir" ]]; then
      log "[$name] Directory missing, waiting 30s..."
      sleep 30
      continue
    fi

    # Increment persistent session counter so each restart gets a unique name
    count=1
    if [[ -f "$count_file" ]]; then
      count=$(( $(cat "$count_file") + 1 ))
    fi
    echo "$count" > "$count_file"
    session_name="${name}-${count}"

    log "[$name] Starting session '$session_name'..."
    started=$(date +%s)
    (cd "$dir" && exec "$claude" remote-control --name "$session_name") >> "$logfile" 2>&1
    now=$(date +%s)
    elapsed=$(( now - started ))

    if (( elapsed > 60 )); then
      log "[$name] Session '$session_name' ran ${elapsed}s — resetting backoff"
      backoff=5
    else
      log "[$name] Session '$session_name' exited after ${elapsed}s — backing off ${backoff}s"
      sleep "$backoff"
      backoff=$(( backoff * 2 ))
      (( backoff > 60 )) && backoff=60
    fi
  done
}

cleanup() {
  trap - SIGTERM SIGINT
  log "[supervisor] Shutting down all sessions..."
  kill 0 2>/dev/null || true
  wait
  exit 0
}

trap cleanup SIGTERM SIGINT

CLAUDE=$(find_claude) || exit 1
log "[supervisor] Using claude: $CLAUDE"

count=0
while IFS= read -r dir; do
  log "[supervisor] Watching: $dir"
  watch_dir "$dir" "$CLAUDE" &
  count=$(( count + 1 ))
done < <(read_dirs)

if (( count == 0 )); then
  log "[supervisor] ERROR: No directories configured in $CONFIG_FILE"
  exit 1
fi

log "[supervisor] Managing $count session(s)"
wait
