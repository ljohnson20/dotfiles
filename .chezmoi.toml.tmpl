{{- $name := promptStringOnce . "name" "Full name (John Smith)" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $githubPAT := promptStringOnce . "github_pat" "GitHub Personal Access Token" -}}
{{- $machineType := promptStringOnce . "machineType" "Machine type (work, personal, vm)" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    github_pat = {{ $githubPAT | quote }}
    machineType = {{ $machineType | quote }}
